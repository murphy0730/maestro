# OpenAI-compatible model configuration. Leave LLM_API_KEY empty to run in
# degraded mode without network model calls.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Runtime state root. The Runtime creates sessions-v3/, runs/, artifacts/ and
# runtime/journal.jsonl under this directory.
# MAESTRO_DATA_DIR=~/.maestro

# Browser frontend origins allowed by the FastAPI API.
# CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# The only directory the filesystem capabilities (read_file/glob/grep/write_file/
# edit_file) can reach, and the working directory for `bash`. Note that a shell
# cannot be confined the way the filesystem tools are — the per-call human
# approval is what gates it. Defaults to <MAESTRO_DATA_DIR>/workspace.
# WORKSPACE_ROOT=~/.maestro/workspace

# Skill package root, and where trust.json is kept.
# SKILLS_DIR=~/.maestro/skills

# Required by the host-administration APIs: skill import/trust/delete and
# /mcp/servers mutations. Empty means those endpoints always answer 403.
# The frontend must be given the same value as VITE_PRIVILEGED_API_TOKEN, and
# changing this needs a backend restart.
# PRIVILEGED_API_TOKEN=

# MCP servers are NOT configured here. They live under the `mcp_servers` key of
# <MAESTRO_DATA_DIR>/settings.json, managed through PUT /mcp/servers/{name}.
